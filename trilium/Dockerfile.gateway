ARG SUPERGATEWAY_VERSION=4.1.0
FROM node:22-slim
ARG SUPERGATEWAY_VERSION
RUN npm install -g "supergateway@${SUPERGATEWAY_VERSION}" && node --version && supergateway --help > /dev/null
COPY gateway/ /app/gateway/
COPY trilium/server.js /app/trilium/server.js
RUN chmod +x /app/gateway/entrypoint.sh && node --check /app/trilium/server.js
ENV GATEWAY_STDIO_CMD="node /app/trilium/server.js" GATEWAY_STATEFUL="false"
ENTRYPOINT []
CMD ["/app/gateway/entrypoint.sh"]
