FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs npm ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# mcp-proxy (sparfenyuk): connects as a client to an existing SSE-transport
# MCP server and re-exposes it over stdio.
#
# Pinned mcp<2.0: mcp-proxy 0.12.0 imports request_ctx from
# mcp.server.lowlevel.server, which the mcp SDK removed/relocated in its 2.x
# releases. Without this pin the container ImportErrors on every start.
# Re-check this pin whenever either package is bumped.
RUN pip install --no-cache-dir "mcp<2.0" mcp-proxy

COPY run-proxy.sh /app/run-proxy.sh
RUN chmod +x /app/run-proxy.sh

ENTRYPOINT []
# supergateway takes whatever /app/run-proxy.sh exposes over stdio (the
# wrapped SSE server, via mcp-proxy) and re-exposes it as streamable-HTTP
# with its own bearer token - consistent with the docker and files
# connectors.
CMD ["sh", "-c", "npx -y supergateway --stdio /app/run-proxy.sh --outputTransport streamableHttp --port 8000 --oauth2Bearer \"$MCP_BEARER_TOKEN\""]
