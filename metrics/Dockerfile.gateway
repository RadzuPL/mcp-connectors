FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs npm ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ARG MCP_PROXY_VERSION

# mcp-proxy (sparfenyuk): łączy się jako klient do istniejącego serwera SSE
# i wystawia go z powrotem po stdio.
RUN pip install --no-cache-dir mcp-proxy==${MCP_PROXY_VERSION}

COPY run-proxy.sh /app/run-proxy.sh
RUN chmod +x /app/run-proxy.sh

ENTRYPOINT []
# supergateway: bierze to co /app/run-proxy.sh wystawia po stdio
# (czyli Glances przez mcp-proxy) i wystawia to na zewnątrz jako
# streamable-HTTP z własnym bearer tokenem - spójnie z connectorami
# Docker i Files.
CMD ["sh", "-c", "npx -y supergateway --stdio /app/run-proxy.sh --outputTransport streamableHttp --port 8000 --oauth2Bearer \"$MCP_BEARER_TOKEN\""]
