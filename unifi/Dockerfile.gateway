FROM python:3.13-slim

# Links the published image to this repository on ghcr.io.
LABEL org.opencontainers.image.source="https://github.com/RadzuPL/mcp-connectors"

# Pinned PyPI version of unifi-network-mcp, taken from UPSTREAM_REF by build-unifi.yml.
# (The package requires Python >= 3.13.)
ARG UNIFI_MCP_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs npm ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# supergateway is installed at build time instead of via `npx -y` on every start,
# so starting the container does not depend on the npm registry.
RUN pip install --no-cache-dir "unifi-network-mcp==${UNIFI_MCP_VERSION}" \
    && npm install -g supergateway

# supergateway (4.1.0) has NO inbound authentication: its --oauth2Bearer flag only
# adds an Authorization header and never checks incoming requests. auth-proxy.js is
# what actually checks the token; entrypoint.sh runs supergateway on loopback and the
# proxy on :8000 in front of it. 4.1.0 also has no --host flag, so force-loopback.js
# pins its port to 127.0.0.1 (otherwise other containers on the network could reach it
# directly). The server's own HTTP transport is not enabled.
COPY auth-proxy.js force-loopback.js entrypoint.sh /app/
RUN chmod +x /app/entrypoint.sh

EXPOSE 8000
CMD ["/app/entrypoint.sh"]
