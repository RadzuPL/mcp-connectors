FROM python:3.13-slim

# Links the published image to this repository on ghcr.io.
LABEL org.opencontainers.image.source="https://github.com/RadzuPL/mcp-connectors"

# Pinned PyPI version of unifi-network-mcp, taken from UPSTREAM_REF by build-unifi.yml.
# (The package requires Python >= 3.13.)
ARG UNIFI_MCP_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs npm ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# supergateway is installed at build time instead of via `npx -y` on every start,
# so starting the container does not depend on the npm registry.
RUN pip install --no-cache-dir "unifi-network-mcp==${UNIFI_MCP_VERSION}" \
    && npm install -g supergateway

# supergateway wraps the server's stdio interface and exposes it as
# streamable-HTTP, gated by its own bearer token. The server's own HTTP
# transport (unauthenticated upstream) is deliberately NOT enabled.
CMD ["sh", "-c", "supergateway --stdio 'unifi-network-mcp' --outputTransport streamableHttp --port 8000 --oauth2Bearer \"$MCP_BEARER_TOKEN\""]
