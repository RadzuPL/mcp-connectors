FROM python:3.13-slim

# Links the published image to this repository on ghcr.io.
LABEL org.opencontainers.image.source="https://github.com/RadzuPL/mcp-connectors"

# Pinned PyPI version of unifi-network-mcp, taken from UPSTREAM_REF by build-unifi.yml.
# (The package requires Python >= 3.13.)
ARG UNIFI_MCP_VERSION
# supergateway 4.1.0 needs Node >= 20; python:3.13-slim is Debian 13, whose nodejs is 20.x.
ARG SUPERGATEWAY_VERSION=4.1.0

RUN apt-get update && apt-get install -y --no-install-recommends \
    nodejs npm ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# supergateway is installed at build time instead of via `npx -y` on every start,
# so starting the container does not depend on the npm registry. The last two commands
# fail the build if Node is too old or supergateway cannot start.
RUN pip install --no-cache-dir "unifi-network-mcp==${UNIFI_MCP_VERSION}" \
    && npm install -g "supergateway@${SUPERGATEWAY_VERSION}" \
    && node -e "if (parseInt(process.versions.node, 10) < 20) { console.error('Node >= 20 required, got ' + process.version); process.exit(1); }" \
    && supergateway --help > /dev/null

# Shared authenticating front end (see gateway/README.md). Build context = repository root.
COPY gateway/ /app/gateway/
RUN chmod +x /app/gateway/entrypoint.sh

# unifi-network-mcp logs in to the controller every time it starts, and UniFi OS rate-limits
# logins, so it must run once per client session (stateful), not once per request.
# Claude opens a session per tool call, so stateful still logs in once per call; set
# GATEWAY_SHARED_SESSION=true at run time (opt-in) for one login per container lifetime.
ENV GATEWAY_STDIO_CMD="unifi-network-mcp" \
    GATEWAY_STATEFUL="true"

EXPOSE 8000
ENTRYPOINT []
CMD ["/app/gateway/entrypoint.sh"]
