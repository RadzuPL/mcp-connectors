FROM node:20-slim
ARG MCP_FS_VERSION
# supergateway 4.1.0 needs Node >= 20, which this base image has.
ARG SUPERGATEWAY_VERSION=4.1.0

# The last command fails the build if supergateway cannot start.
RUN npm install -g "@modelcontextprotocol/server-filesystem@${MCP_FS_VERSION}" "supergateway@${SUPERGATEWAY_VERSION}" \
    && supergateway --help > /dev/null

# Shared authenticating front end (see gateway/README.md). Build context = repository root.
COPY gateway/ /app/gateway/
RUN chmod +x /app/gateway/entrypoint.sh

# Optional access policy in front of the file server (see files/README.md): hides and
# refuses paths such as secrets.yaml. It does nothing unless DENY_NAMES, ALLOW_ONLY or
# READ_ONLY is set when the container starts; then the server runs behind it.
COPY files/deny-policy.js files/deny-proxy.js /app/files/

# ALLOWED_DIRS is set when the container is started; the escaped $ keeps it literal here,
# and the shell that supergateway runs the command in expands it.
ENV GATEWAY_STDIO_CMD="node /app/files/deny-proxy.js mcp-server-filesystem \$ALLOWED_DIRS" \
    GATEWAY_STATEFUL="false"

ENTRYPOINT []
CMD ["/app/gateway/entrypoint.sh"]
